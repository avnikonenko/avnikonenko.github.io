---
import ExternalLink from "@components/ExternalLink.astro";
import Icon from "@components/Icon.astro";
import Prose from "@components/Prose.astro";
import TagList from "@components/TagList.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { projects } from "@data/projects";
import type { Project } from "@data/types";
import { stripHighlightMarkers } from "@utils/highlightTerms";
import { withBase } from "@utils/paths";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const summary = stripHighlightMarkers(project.shortSummary);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: project.title,
  description: summary,
  codeRepository: project.githubRepository,
};
---

<BaseLayout
  title={project.title}
  path={`/projects/${project.slug}/`}
  description={summary}
  structuredData={structuredData}
>
  <section class="page-section project-head">
    <p class="eyebrow project-eyebrow">
      <a
        class="back-link"
        href={withBase("/projects/")}
        aria-label="Back to projects"
      >
        <Icon name="arrow-left" />
      </a>
      Project
    </p>
    <h1>{project.title}</h1>
    <p class="lede">
      <Prose text={project.shortSummary} />
    </p>
    <TagList tags={project.tags} />
    <div class="inline-actions">
      {
        project.githubRepository && (
          <ExternalLink
            href={project.githubRepository}
            label="Code on GitHub"
            icon="github"
          />
        )
      }
      {
        project.documentationLink && (
          <ExternalLink
            href={project.documentationLink}
            label="Documentation"
          />
        )
      }
      {
        project.publicationLinks.map((link) => (
          <ExternalLink href={link.href} label={link.label} />
        ))
      }
      {project.linkNotes?.map((note) => <span class="muted">{note}</span>)}
    </div>
  </section>

  <section class="page-section">
    <div class="detail-rows">
      <div class="detail-row">
        <h2>Scientific problem</h2>
        <p><Prose text={project.scientificProblem} /></p>
      </div>

      <div class="detail-row">
        <h2>Motivation</h2>
        <p><Prose text={project.motivation} /></p>
      </div>

      <div class="detail-row">
        <h2>My role</h2>
        <ul>
          {
            project.myRole.map((item) => (
              <li>
                <Prose text={item} />
              </li>
            ))
          }
        </ul>
      </div>

      <div class="detail-row">
        <h2>Methodology</h2>
        <ul>
          {
            project.methodology.map((item) => (
              <li>
                <Prose text={item} />
              </li>
            ))
          }
        </ul>
      </div>

      <div class="detail-row">
        <h2>Results</h2>
        <ul>
          {
            project.outputsOrValidation.map((item) => (
              <li>
                <Prose text={item} />
              </li>
            ))
          }
        </ul>
      </div>

      <div class="detail-row">
        <h2>Software</h2>
        <ul class="skill-list">
          {project.methodsAndTechnologies.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="page-section page-section--tight">
    <p><a href={withBase("/projects/")}>Back to projects</a></p>
  </section>
</BaseLayout>
