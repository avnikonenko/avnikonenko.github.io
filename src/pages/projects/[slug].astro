---
import ExternalLink from "@components/ExternalLink.astro";
import TagList from "@components/TagList.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { projects } from "@data/projects";
import type { Project } from "@data/types";
import { withBase } from "@utils/paths";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: project.title,
  description: project.shortSummary,
  codeRepository: project.githubRepository,
};
---

<BaseLayout
  title={project.title}
  path={`/projects/${project.slug}/`}
  description={project.shortSummary}
  structuredData={structuredData}
>
  <section class="page-section">
    <p class="eyebrow">Project</p>
    <h1>{project.title}</h1>
    <p class="lede">{project.shortSummary}</p>
    <TagList tags={project.tags} />
    <div class="inline-actions">
      {
        project.githubRepository && (
          <ExternalLink
            href={project.githubRepository}
            label="Code on GitHub"
          />
        )
      }
      {
        project.documentationLink && (
          <ExternalLink
            href={project.documentationLink}
            label="Documentation"
          />
        )
      }
      {
        project.publicationLinks.map((link) => (
          <ExternalLink href={link.href} label={link.label} />
        ))
      }
    </div>
  </section>

  <section class="page-section">
    <h2>Scientific problem</h2>
    <p>{project.scientificProblem}</p>
  </section>

  <section class="page-section">
    <h2>Motivation</h2>
    <p>{project.motivation}</p>
  </section>

  <section class="page-section">
    <h2>My role</h2>
    <ul class="detail-list">
      {project.myRole.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="page-section">
    <h2>Methodology</h2>
    <ul class="detail-list">
      {project.methodology.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="page-section">
    <h2>Results</h2>
    <ul class="detail-list">
      {project.outputsOrValidation.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="page-section">
    <h2>Limitations</h2>
    <ul class="detail-list">
      {project.limitations.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="page-section">
    <h2>Software and technologies</h2>
    <ul class="skill-list">
      {project.methodsAndTechnologies.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="page-section">
    <p><a href={withBase("/projects/")}>Back to projects</a></p>
  </section>
</BaseLayout>
