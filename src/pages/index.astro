---
import SkillCloud from "@components/SkillCloud.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { profile } from "@data/profile";
import { siteConfig } from "@data/site";
import { skills } from "@data/skills";
import { versioned } from "@utils/assetVersion";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      name: siteConfig.name,
      jobTitle: siteConfig.title,
      url: siteConfig.siteUrl,
      email: siteConfig.emailDisplay,
      sameAs: siteConfig.socialLinks.map((link) => link.href),
      knowsAbout: skills.flatMap((group) => group.skills).slice(0, 25),
    },
    {
      "@type": "WebSite",
      name: siteConfig.name,
      url: siteConfig.siteUrl,
      description: siteConfig.description,
    },
  ],
};
---

<BaseLayout structuredData={structuredData}>
  <section class="page-section home-head">
    <img
      class="home-logo home-logo--light"
      src={versioned("/logo-dark-256.png")}
      width="128"
      height="128"
      alt=""
    />
    <img
      class="home-logo home-logo--dark"
      src={versioned("/logo-256.png")}
      width="128"
      height="128"
      alt=""
    />
    <div>
      <h1>{profile.name}</h1>
      <p class="identity-line">
        {siteConfig.title} · {siteConfig.location}
      </p>
      <p class="availability">{siteConfig.availability}</p>
    </div>
  </section>

  <section class="page-section">
    <SkillCloud />
  </section>
</BaseLayout>
