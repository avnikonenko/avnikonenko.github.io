---
import SectionHeading from "@components/SectionHeading.astro";
import SkillGroup from "@components/SkillGroup.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { profile } from "@data/profile";
import { siteConfig } from "@data/site";
import { skills } from "@data/skills";
import { withBase } from "@utils/paths";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      name: siteConfig.name,
      jobTitle: siteConfig.title,
      url: siteConfig.siteUrl,
      email: siteConfig.emailDisplay,
      sameAs: siteConfig.socialLinks.map((link) => link.href),
      knowsAbout: skills.flatMap((group) => group.skills).slice(0, 25),
    },
    {
      "@type": "WebSite",
      name: siteConfig.name,
      url: siteConfig.siteUrl,
      description: siteConfig.description,
    },
  ],
};
---

<BaseLayout structuredData={structuredData}>
  <section class="page-section">
    <h1>{profile.name}</h1>
    <p class="identity-line">
      {siteConfig.title} · {siteConfig.location}
    </p>
    <p class="availability">{siteConfig.availability}</p>
    <div class="grid about-biography">
      {profile.biography.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <p class="page-section--tight">
      <a class="button button--primary" href={withBase(siteConfig.cvPdf)}
        >Download CV (PDF)</a
      >
    </p>
  </section>

  <section class="page-section">
    <SectionHeading title="Skills" />
    <div class="grid">
      {skills.map((group) => <SkillGroup group={group} />)}
    </div>
  </section>
</BaseLayout>
