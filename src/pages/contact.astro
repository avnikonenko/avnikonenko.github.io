---
import ExternalLink from "@components/ExternalLink.astro";
import SectionHeading from "@components/SectionHeading.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { siteConfig } from "@data/site";
import { withBase } from "@utils/paths";
---

<BaseLayout
  title="Contact"
  path="/contact/"
  description="Contact details and professional profiles for Aleksandra Ivanova."
>
  <section class="page-section">
    <SectionHeading eyebrow="Contact" title="Get in touch" />
    <p>
      <a href={siteConfig.emailHref}>{siteConfig.emailDisplay}</a>
    </p>
    <p class="muted">{siteConfig.location}</p>
    <p>{siteConfig.availability}</p>
  </section>

  <section class="page-section">
    <SectionHeading title="Profiles" />
    <ul class="link-row">
      {
        siteConfig.socialLinks.map((link) => (
          <li>
            <ExternalLink href={link.href} label={link.label} />
          </li>
        ))
      }
    </ul>
    <p class="page-section--tight">
      <a href={withBase(siteConfig.cvPdf)}>Download CV (PDF)</a>
    </p>
  </section>
</BaseLayout>
