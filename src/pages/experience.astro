---
import ExperienceTimeline from "@components/ExperienceTimeline.astro";
import SectionHeading from "@components/SectionHeading.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { conferences } from "@data/conferences";
import { education } from "@data/education";
import { experience } from "@data/experience";
---

<BaseLayout
  title="Experience"
  path="/experience/"
  description="Experience, education, talks and teaching of Aleksandra Ivanova."
>
  <section class="page-section">
    <SectionHeading title="Experience" />
    <ExperienceTimeline items={experience} />
  </section>

  <section class="page-section">
    <SectionHeading title="Education" />
    <ol class="timeline">
      {
        education.map((item) => (
          <li class="timeline__item">
            <div class="timeline__date">
              {item.start}–{item.end}
            </div>
            <div class="timeline__content">
              <h3>{item.degree}</h3>
              <p class="organization">
                {item.institution}
                {item.location ? `, ${item.location}` : ""}
              </p>
              {item.thesis && (
                <p>
                  <strong>Thesis:</strong>{" "}
                  {item.thesisUrl ? (
                    <a href={item.thesisUrl}>{item.thesis}</a>
                  ) : (
                    item.thesis
                  )}
                </p>
              )}
              {item.status && <p>{item.status}</p>}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="page-section">
    <SectionHeading title="Talks and teaching" />
    <ol class="timeline">
      {
        conferences.map((item) => (
          <li class="timeline__item">
            <div class="timeline__date">{item.year}</div>
            <div class="timeline__content">
              <h3>{item.title}</h3>
              <p class="organization">
                {item.type} · {item.event}, {item.location}
              </p>
              {item.note && <p>{item.note}</p>}
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>
