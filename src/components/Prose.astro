---
import { splitHighlightedTerms } from "@utils/highlightTerms";

interface Props {
  text: string;
}

const { text } = Astro.props;
const segments = splitHighlightedTerms(text);
---

{
  segments.map((segment) =>
    segment.kind ? (
      <strong class:list={["highlight", `highlight--${segment.kind}`]}>
        {segment.text}
      </strong>
    ) : (
      segment.text
    ),
  )
}
