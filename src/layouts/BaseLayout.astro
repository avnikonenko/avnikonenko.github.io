---
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import SEOHead from "@components/SEOHead.astro";
import { versioned } from "@utils/assetVersion";
import "@styles/global.css";

interface Props {
  title?: string;
  description?: string;
  path?: string;
  structuredData?: Record<string, unknown>;
}

const { title, description, path, structuredData } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch {
          stored = null;
        }
        document.documentElement.dataset.theme =
          stored === "light" ? "light" : "dark";
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="icon"
      href={versioned("/icon-32.png")}
      type="image/png"
      sizes="32x32"
    />
    <link
      rel="apple-touch-icon"
      href={versioned("/icon-180.png")}
      sizes="180x180"
    />
    <SEOHead
      title={title}
      description={description}
      path={path}
      structuredData={structuredData}
    />
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
